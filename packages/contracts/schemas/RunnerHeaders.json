{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Authorization": {
      "type": "string",
      "pattern": "^Bearer .+$"
    },
    "X-Run-Attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    }
  },
  "required": [
    "Authorization",
    "X-Run-Attempt"
  ],
  "additionalProperties": false
}
