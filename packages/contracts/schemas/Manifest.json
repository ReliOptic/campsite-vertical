{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "entry": {
      "type": "string",
      "const": "index.html"
    },
    "poster": {
      "type": "string",
      "const": "poster.png"
    },
    "aspect": {
      "type": "string",
      "enum": [
        "9:16",
        "free"
      ]
    },
    "durationHintMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "files": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[a-z0-9._-]+(\\/[a-z0-9._-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3145728
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "runId",
        "modelId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "title",
    "summary",
    "entry",
    "poster",
    "aspect",
    "durationHintMs",
    "files",
    "generator"
  ],
  "additionalProperties": false
}
