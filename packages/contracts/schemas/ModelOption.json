{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tier": {
      "type": "string",
      "enum": [
        "cheap",
        "balanced",
        "frontier"
      ]
    }
  },
  "required": [
    "id",
    "label",
    "tier"
  ],
  "additionalProperties": false
}
