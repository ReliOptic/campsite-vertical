{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "vistaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "channelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "aspect": {
      "type": "string",
      "enum": [
        "9:16",
        "free"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "motion",
          "3d",
          "interactive"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "atMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120000
          }
        },
        "required": [
          "id",
          "label",
          "atMs"
        ],
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "atMs",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "playUrl": {
      "type": "string",
      "format": "uri"
    },
    "posterUrl": {
      "type": "string",
      "format": "uri"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "published": {
      "type": "boolean"
    },
    "owned": {
      "type": "boolean"
    },
    "origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vistaId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "channelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "vistaId",
            "channelId",
            "workspaceId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "durationHintMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "vistaId",
    "revisionId",
    "channelId",
    "title",
    "summary",
    "aspect",
    "playUrl",
    "posterUrl",
    "expiresAt",
    "published",
    "owned",
    "origin",
    "durationHintMs"
  ],
  "additionalProperties": false
}
