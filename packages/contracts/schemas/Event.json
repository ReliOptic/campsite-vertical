{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "phase"
        },
        "phase": {
          "type": "string",
          "enum": [
            "QUEUED",
            "SEARCHING",
            "DRAFTING",
            "VERIFYING",
            "DONE"
          ]
        }
      },
      "required": [
        "type",
        "phase"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "log"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "artifact"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false
    }
  ]
}
