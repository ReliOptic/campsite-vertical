{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-zA-Z0-9_]{1,40}$"
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "string",
        "maxLength": 200
      },
      {
        "type": "number"
      },
      {
        "type": "boolean"
      },
      {
        "type": "null"
      }
    ]
  }
}
