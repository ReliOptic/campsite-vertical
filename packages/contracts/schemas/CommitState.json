{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseStateRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "patch": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "replace"
              },
              "path": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80,
                "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "add"
              },
              "path": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80,
                "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "remove"
              },
              "path": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80,
                "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
              }
            },
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "baseStateRevision",
    "idempotencyKey",
    "patch"
  ],
  "additionalProperties": false
}
