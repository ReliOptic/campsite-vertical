{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "channelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "prompt": {
      "type": "string"
    },
    "channelBrief": {
      "type": "string"
    },
    "recent": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "pro"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memMb": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutSec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxRepair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "browser": {
          "type": "boolean"
        }
      },
      "required": [
        "cpus",
        "memMb",
        "timeoutSec",
        "maxRepair",
        "browser"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "openrouter"
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "apiKey": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId",
        "apiKey"
      ],
      "additionalProperties": false
    },
    "artifactVersion": {
      "type": "string",
      "const": "1"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "initial",
        "manual",
        "scheduled",
        "fork"
      ]
    }
  },
  "required": [
    "runId",
    "channelId",
    "attempt",
    "prompt",
    "channelBrief",
    "recent",
    "profile",
    "limits",
    "model",
    "artifactVersion"
  ],
  "additionalProperties": false
}
