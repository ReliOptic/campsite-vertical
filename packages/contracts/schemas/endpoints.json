                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "used",
                  "max"
                ],
                "additionalProperties": false
              },
              "runsToday": {
                "type": "object",
