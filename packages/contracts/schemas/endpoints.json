                "maximum": 120000
              },
              "files": {
                "minItems": 2,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 240,
                      "pattern": "^[a-z0-9._-]+(\\/[a-z0-9._-]+)*$"
