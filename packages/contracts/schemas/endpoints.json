                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "modelId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "runId",
                  "modelId"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema",
              "title",
              "summary",
              "entry",
              "poster",
              "aspect",
              "durationHintMs",
              "files",
              "generator"
            ],
            "additionalProperties": false
          },
          "usage": {
            "type": "object",
