{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "hostCpus": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hostMemMb": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "nodeId",
    "hostCpus",
    "hostMemMb",
    "version"
  ],
  "additionalProperties": false
}
