{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "replace"
        },
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "add"
        },
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "remove"
        },
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^\\/[a-zA-Z0-9_]{1,40}$"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false
    }
  ]
}
