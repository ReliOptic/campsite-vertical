{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "atMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    }
  },
  "required": [
    "id",
    "label",
    "atMs"
  ],
  "additionalProperties": false
}
