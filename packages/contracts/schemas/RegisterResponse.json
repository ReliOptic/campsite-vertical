    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    }
  },
  "required": [
    "nodeId"
  ],
  "additionalProperties": false
}
