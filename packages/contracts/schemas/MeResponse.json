{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "avatarUrl"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "pro"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "used",
            "max"
          ],
          "additionalProperties": false
        },
        "runsToday": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "used",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "channels",
        "runsToday"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user",
    "plan",
    "usage"
  ],
  "additionalProperties": false
}
