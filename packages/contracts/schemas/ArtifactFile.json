{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-z0-9._-]+(\\/[a-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3145728
    }
  },
  "required": [
    "path",
    "sha256",
    "bytes"
  ],
  "additionalProperties": false
}
