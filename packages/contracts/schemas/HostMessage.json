      },
      "required": [
        "type",
        "sceneId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "campsite:restore"
        },
        "state": {
          "type": "object",
