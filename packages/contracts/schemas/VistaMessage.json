{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "campsite:ready"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "campsite:state"
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{1,40}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "campsite:scene"
        },
        "sceneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        }
      },
      "required": [
        "type",
        "sceneId"
      ],
      "additionalProperties": false
    }
  ]
}
