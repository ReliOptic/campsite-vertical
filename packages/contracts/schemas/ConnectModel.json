{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "openrouter"
    },
    "apiKey": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "pattern": "^sk-or-"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verify": {
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "apiKey"
  ],
  "additionalProperties": false
}
